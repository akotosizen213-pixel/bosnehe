local function Toggle(parent, default, callback)
    local on = default

    local track = New("Frame", {
        Size             = UDim2.new(0, 32, 0, 16),
        Position         = UDim2.new(1, -36, 0.5, -8),
        BackgroundColor3 = on and ACCENT or DIM,
        BorderSizePixel  = 0,
        ZIndex           = 7,
        Parent           = parent,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 8), Parent = track })

    local knob = New("Frame", {
        Size             = UDim2.new(0, 11, 0, 11),
        Position         = on and UDim2.new(0, 17, 0.5, -5) or UDim2.new(0, 2, 0.5, -5),
        BackgroundColor3 = on and BLACK or MUTED,
        BorderSizePixel  = 0,
        ZIndex           = 8,
        Parent           = track,
    })
    New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local hitbox = New("TextButton", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text             = "",
        ZIndex           = 9,
        Parent           = track,
    })

    hitbox.MouseButton1Click:Connect(function()
        on = not on
        Tween(track, { BackgroundColor3 = on and ACCENT or DIM })
        Tween(knob, {
            Position         = on and UDim2.new(0, 17, 0.5, -5) or UDim2.new(0, 2, 0.5, -5),
            BackgroundColor3 = on and BLACK or MUTED,
        })
        if callback then callback(on) end
    end)

    return track, function() return on end
end

local function Slider(parent, min, max, default, suffix, callback)
    suffix = suffix or ""
    local val    = default
    local trackW = 80

    local holder = New("Frame", {
        Size             = UDim2.new(0, trackW + 34, 0, 16),
        Position         = UDim2.new(1, -(trackW + 36), 0.5, -8),
        BackgroundTransparency = 1,
        ZIndex           = 7,
        Parent           = parent,
    })

    local track = New("Frame", {
        Size             = UDim2.new(0, trackW, 0, 3),
        Position         = UDim2.new(0, 0, 0.5, -1),
        BackgroundColor3 = DIM,
        BorderSizePixel  = 0,
        ZIndex           = 7,
        Parent           = holder,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 2), Parent = track })

    local fill = New("Frame", {
        Size             = UDim2.new((val - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = WHITE,
        BorderSizePixel  = 0,
        ZIndex           = 8,
        Parent           = track,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 2), Parent = fill })

    local thumb = New("Frame", {
        Size             = UDim2.new(0, 10, 0, 10),
        Position         = UDim2.new((val - min) / (max - min), -5, 0.5, -5),
        BackgroundColor3 = WHITE,
        BorderSizePixel  = 0,
        ZIndex           = 9,
        Parent           = track,
    })
    New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = thumb })

    local valLbl = New("TextLabel", {
        Size             = UDim2.new(0, 32, 1, 0),
        Position         = UDim2.new(0, trackW + 4, 0, 0),
        BackgroundTransparency = 1,
        Text             = tostring(math.round(val)) .. suffix,
        TextColor3       = WHITE,
        TextSize         = 9,
        Font             = Enum.Font.Code,
        TextXAlignment   = Enum.TextXAlignment.Right,
        ZIndex           = 7,
        Parent           = holder,
    })

    local draggingSlider = false

    local hitbox = New("TextButton", {
        Size             = UDim2.new(0, trackW, 1, 0),
        BackgroundTransparency = 1,
        Text             = "",
        ZIndex           = 10,
        Parent           = holder,
    })

    local function update(inputX)
        local rel = math.clamp((inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        val = math.round(min + rel * (max - min))
        fill.Size      = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, -5, 0.5, -5)
        valLbl.Text    = tostring(val) .. suffix
        if callback then callback(val) end
    end

    hitbox.MouseButton1Down:Connect(function() draggingSlider = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingSlider and i.UserInputType == Enum.UserInputType.MouseMovement then
            update(i.Position.X)
        end
    end)
    hitbox.MouseButton1Click:Connect(function()
        update(UserInputService:GetMouseLocation().X)
    end)

    return holder
end

local function Dropdown(parent, options, default, callback)
    local current = default or options[1]
    local open    = false

    local btn = New("TextButton", {
        Size             = UDim2.new(0, 84, 0, 18),
        Position         = UDim2.new(1, -88, 0.5, -9),
        BackgroundColor3 = MID,
        Text             = current,
        TextColor3       = LABEL,
        TextSize         = 9,
        Font             = Enum.Font.Code,
        BorderSizePixel  = 0,
        ZIndex           = 10,
        Parent           = parent,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = btn })
    New("UIStroke", { Color = DIM, Thickness = 1, Parent = btn })

    local ddFrame = New("Frame", {
        Size             = UDim2.new(0, 84, 0, #options * 20 + 4),
        Position         = UDim2.new(1, -88, 1, 2),
        BackgroundColor3 = MID,
        BorderSizePixel  = 0,
        ZIndex           = 20,
        Visible          = false,
        Parent           = parent,
    })
    New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = ddFrame })
    New("UIStroke", { Color = DIM, Thickness = 1, Parent = ddFrame })
    New("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2), Parent = ddFrame })
    New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = ddFrame })

    for i, opt in ipairs(options) do
        local item = New("TextButton", {
            Size             = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Text             = opt,
            TextColor3       = opt == current and WHITE or MUTED,
            TextSize         = 9,
            Font             = Enum.Font.Code,
            LayoutOrder      = i,
            ZIndex           = 21,
            Parent           = ddFrame,
        })
        item.MouseButton1Click:Connect(function()
            current      = opt
            btn.Text     = opt
            ddFrame.Visible = false
            open         = false
            for _, c in ipairs(ddFrame:GetChildren()) do
                if c:IsA("TextButton") then
                    c.TextColor3 = c.Text == current and WHITE or MUTED
                end
            end
            if callback then callback(opt) end
        end)
    end

    btn.MouseButton1Click:Connect(function()
        open = not open
        ddFrame.Visible = open
    end)

    return btn
end

