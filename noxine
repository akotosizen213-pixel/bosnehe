-- ================================================
-- AIMBOT LOGIC
-- ================================================

local function getTarget()
    local cam      = workspace.CurrentCamera
    local best     = Config.AimBot.FOVRadius
    local target   = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Config.AimBot.TeamCheck and plr.Team == LocalPlayer.Team then continue end

        local char = plr.Character
        if not char then continue end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local partName = Config.AimBot.HitScan == "Head" and "Head"
                      or Config.AimBot.HitScan == "Neck" and ("UpperTorso" or "Torso")
                      or "HumanoidRootPart"
        local part = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        if Config.AimBot.WallCheck then
            local origin    = cam.CFrame.Position
            local direction = (part.Position - origin).Unit * 2000
            local params    = RaycastParams.new()
            params.FilterDescendantsInstances = {LocalPlayer.Character, cam}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local result = workspace:Raycast(origin, direction, params)
            if result and not result.Instance:IsDescendantOf(char) then continue end
        end

        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local dist   = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if dist < best then
            best   = dist
            target = part
        end
    end
    return target
end

RunService.RenderStepped:Connect(function(dt)
    if not Config.AimBot.Enable then return end

    local active = Config.AimBot.UseMouse
        and UserInputService:IsMouseButtonPressed(Config.AimBot.MouseBind)
        or  UserInputService:IsKeyDown(Config.AimBot.KeyBind)

    if not active then return end

    local part = getTarget()
    if not part then return end

    local cam = workspace.CurrentCamera
    local pos = part.Position

    if Config.AimBot.Prediction then
        local vel = part.AssemblyLinearVelocity or Vector3.zero
        pos = pos + vel * (Config.AimBot.PredAmount / 100) * dt
    end

    local sp, onScreen = cam:WorldToViewportPoint(pos)
    if not onScreen then return end

    if Config.AimBot.StickyAim then
        local mouse = UserInputService:GetMouseLocation()
        local smooth = math.max(1, Config.AimBot.Smoothing)
        local nx = mouse.X + (sp.X - mouse.X) / smooth
        local ny = mouse.Y + (sp.Y - mouse.Y) / smooth
        mousemoverel(nx - mouse.X, ny - mouse.Y)
    else
        local smooth = math.max(1, Config.AimBot.Smoothing)
        local lookAt = CFrame.lookAt(cam.CFrame.Position, pos)
        cam.CFrame   = cam.CFrame:Lerp(lookAt, 1 / smooth)
    end
end)

