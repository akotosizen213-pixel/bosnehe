local espCache={}
local function removeESP(plr)
    if espCache[plr] then
        if espCache[plr].hl then pcall(function() espCache[plr].hl:Destroy() end) end
        espCache[plr]=nil
    end
end

RunService.RenderStepped:Connect(function()
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr==LocalPlayer then continue end
        if not Config.ESP.Enable then removeESP(plr); continue end
        if not Config.ESP.ShowTeammates and plr.Team==LocalPlayer.Team then removeESP(plr); continue end
        local char=plr.Character
        if not char then removeESP(plr); continue end
        local root=char:FindFirstChild("HumanoidRootPart")
        if not root then removeESP(plr); continue end
        local cam=workspace.CurrentCamera
        local dist=(cam.CFrame.Position-root.Position).Magnitude
        if dist>Config.ESP.MaxDistance then removeESP(plr); continue end
        if not espCache[plr] then espCache[plr]={} end
        -- Highlight
        if Config.ESP.FullBodyHighlight then
            if not espCache[plr].hl or not espCache[plr].hl.Parent then
                local hl=Instance.new("Highlight")
                hl.Adornee=char
                hl.FillColor=Config.ESP.HighlightColor
                hl.FillTransparency=1-Config.ESP.HighlightOpacity
                hl.OutlineColor=Config.ESP.HighlightColor
                hl.OutlineTransparency=0
                hl.Parent=char
                espCache[plr].hl=hl
            else
                local hl=espCache[plr].hl
                hl.FillColor=Config.ESP.HighlightColor
                hl.FillTransparency=1-Config.ESP.HighlightOpacity
                hl.OutlineColor=Config.ESP.HighlightColor
            end
        else
            if espCache[plr].hl then
                pcall(function() espCache[plr].hl:Destroy() end)
                espCache[plr].hl=nil
            end
        end
    end
end)

Players.PlayerRemoving:Connect(removeESP)

